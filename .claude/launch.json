{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "count-of-ashes",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "server/app.py",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "game-static",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "-d",
        "game",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8766
    }
  ]
}